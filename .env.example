# Puerto interno en el que escucha Express dentro del contenedor/proceso.
PORT=3000

NODE_ENV=production

# Puerto/host del *servidor* donde docker-compose publica el contenedor.
# El Caddy ya existente en el servidor debe apuntar aquí (reverse_proxy 127.0.0.1:HOST_PORT).
HOST_BIND=127.0.0.1
HOST_PORT=3000

# Tokens de acceso a los MCPs. Formato: token[:scope1|scope2],token2[:scope]
# - Sin scope (o con "*"): el token tiene acceso a TODOS los MCPs registrados.
# - Con scope: acceso limitado a los MCPs cuyo `name` (ver src/registry) coincida.
# Genera tokens con: openssl rand -hex 32
MCP_AUTH_TOKENS=CAMBIA_ESTE_TOKEN:*

# --- OAuth (custom connector de CUENTA en claude.ai, Settings → Connectors) ---
# Los tokens estáticos de arriba solo sirven para clientes locales (config file,
# mcp-remote, curl). El conector de cuenta en claude.ai solo sabe hacer OAuth,
# así que este gateway también puede actuar como authorization server OAuth 2.1
# + Dynamic Client Registration para un único usuario administrador (ver
# src/auth/oauth.ts). Si dejas cualquiera de estas 3 variables sin definir, el
# authorization server queda deshabilitado (el resto del gateway sigue igual).

# Firma los access/refresh tokens JWT que emite este gateway. Genera con:
# openssl rand -hex 32
OAUTH_JWT_SECRET=

# Credenciales que se piden en la pantalla /authorize al conectar el custom
# connector desde claude.ai. Un login válido da acceso total (equivalente a
# scope "*" en MCP_AUTH_TOKENS) porque no hay noción de múltiples cuentas.
OAUTH_ADMIN_USER=admin
OAUTH_ADMIN_PASSWORD=CAMBIA_ESTA_PASSWORD

# Dónde persistir los clientes OAuth que claude.ai registra dinámicamente
# (Dynamic Client Registration), para no perderlos en cada reinicio. En Docker
# ya se monta un volumen a /app/data (ver docker-compose.yml); normalmente no
# hace falta tocar esto.
# OAUTH_CLIENTS_FILE=./data/oauth-clients.json

# --- MCP "appflowy" (https://github.com/CAREEMER/appflowy-mcp) ---
# Corre como servicio aparte (ver docker-compose.yml, imagen m2n2/appflowy-mcp).
# Si APPFLOWY_MCP_INTERNAL_TOKEN no está definido, este MCP queda deshabilitado
# y solo se monta el resto del registry.

# Credenciales de la cuenta de servicio que el sidecar usa contra tu AppFlowy Cloud.
APPFLOWY_BASE_URL=https://appflowy.example.com
APPFLOWY_EMAIL=service@example.com
APPFLOWY_PASSWORD=CAMBIA_ESTA_PASSWORD

# Token interno compartido entre este gateway y el sidecar (no lo expongas a clientes:
# el cliente usa su propio token de MCP_AUTH_TOKENS con scope "appflowy").
# Genera con: openssl rand -hex 32
APPFLOWY_MCP_INTERNAL_TOKEN=CAMBIA_ESTE_TOKEN_INTERNO

# Solo necesario si el sidecar no se llama "appflowy-mcp" en la red de docker-compose
# o si corres el MCP de AppFlowy fuera de Docker.
# APPFLOWY_MCP_TARGET=http://appflowy-mcp:8000/mcp

# --- MCP "dbhub" (https://github.com/bytebase/dbhub) ---
# Corre como servicio aparte (ver docker-compose.yml, imagen bytebase/dbhub).
# DBHub NO autentica a sus clientes HTTP por diseño: nuestra propia auth
# (scope "dbhub" en MCP_AUTH_TOKENS) es la única protección delante de él,
# por eso nunca se publica su puerto al host. Usa un usuario de BD de solo
# lectura salvo que realmente necesites que el MCP escriba.
# Si DBHUB_DSN no está definido, este MCP queda deshabilitado.
DBHUB_DSN=postgres://user:password@host.docker.internal:5432/dbname?sslmode=disable

# Solo necesario si el sidecar no se llama "dbhub-mcp" en la red de docker-compose
# o si corres DBHub fuera de Docker.
# DBHUB_MCP_TARGET=http://dbhub-mcp:8080/mcp

# --- MCP "analytics" (oficial de Google: https://github.com/googleanalytics/google-analytics-mcp,
# más tools de escritura propias, ver docker/analytics-mcp/admin_write_tools.py) ---
# Corre como servicio aparte (ver docker-compose.yml, build ./docker/analytics-mcp).
# Ese paquete de Google solo habla stdio: el sidecar lo envuelve en Streamable
# HTTP reusando el SDK oficial de MCP para Python (ver docker/analytics-mcp/app.py).
# Lectura (reporting, scope analytics.readonly) y escritura (Admin API, scope
# analytics.edit: custom dimensions/metrics, key events, audiences, data
# streams, config de propiedad, vínculos con Google Ads) vía una service
# account de GCP dedicada a la que le diste rol Editor (no solo Viewer) en
# las propiedades GA4 que quieras consultar/modificar
# (Google Analytics → Admin → Property Access Management).
# Si ANALYTICS_MCP_INTERNAL_TOKEN no está definido, este MCP queda deshabilitado.

# Project ID de GCP donde vive la service account (con Analytics Admin API y
# Analytics Data API habilitadas).
GOOGLE_ANALYTICS_PROJECT_ID=

# Ruta EN ESTE HOST (no en el repo, nunca la subas a git) al JSON de la
# service account. docker-compose la monta de solo lectura dentro del sidecar.
ANALYTICS_MCP_SA_KEY_PATH=./secrets/ga-sa-key.json

# Token interno compartido entre este gateway y el sidecar (no lo expongas a
# clientes: el cliente usa su propio token de MCP_AUTH_TOKENS con scope "analytics").
# Genera con: openssl rand -hex 32
ANALYTICS_MCP_INTERNAL_TOKEN=CAMBIA_ESTE_TOKEN_INTERNO

# Solo necesario si el sidecar no se llama "analytics-mcp" en la red de docker-compose.
# ANALYTICS_MCP_TARGET=http://analytics-mcp:8080/mcp
