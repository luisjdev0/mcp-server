# Puerto interno en el que escucha Express dentro del contenedor/proceso.
PORT=3000

NODE_ENV=production

# Puerto/host del *servidor* donde docker-compose publica el contenedor.
# El Caddy ya existente en el servidor debe apuntar aquí (reverse_proxy 127.0.0.1:HOST_PORT).
HOST_BIND=127.0.0.1
HOST_PORT=3000

# Tokens de acceso a los MCPs. Formato: token[:scope1|scope2],token2[:scope]
# - Sin scope (o con "*"): el token tiene acceso a TODOS los MCPs registrados.
# - Con scope: acceso limitado a los MCPs cuyo `name` (ver src/registry) coincida.
# Genera tokens con: openssl rand -hex 32
MCP_AUTH_TOKENS=CAMBIA_ESTE_TOKEN:*

# --- MCP "appflowy" (https://github.com/CAREEMER/appflowy-mcp) ---
# Corre como servicio aparte (ver docker-compose.yml, imagen m2n2/appflowy-mcp).
# Si APPFLOWY_MCP_INTERNAL_TOKEN no está definido, este MCP queda deshabilitado
# y solo se monta el resto del registry.

# Credenciales de la cuenta de servicio que el sidecar usa contra tu AppFlowy Cloud.
APPFLOWY_BASE_URL=https://appflowy.example.com
APPFLOWY_EMAIL=service@example.com
APPFLOWY_PASSWORD=CAMBIA_ESTA_PASSWORD

# Token interno compartido entre este gateway y el sidecar (no lo expongas a clientes:
# el cliente usa su propio token de MCP_AUTH_TOKENS con scope "appflowy").
# Genera con: openssl rand -hex 32
APPFLOWY_MCP_INTERNAL_TOKEN=CAMBIA_ESTE_TOKEN_INTERNO

# Solo necesario si el sidecar no se llama "appflowy-mcp" en la red de docker-compose
# o si corres el MCP de AppFlowy fuera de Docker.
# APPFLOWY_MCP_TARGET=http://appflowy-mcp:8000/mcp

# --- MCP "dbhub" (https://github.com/bytebase/dbhub) ---
# Corre como servicio aparte (ver docker-compose.yml, imagen bytebase/dbhub).
# DBHub NO autentica a sus clientes HTTP por diseño: nuestra propia auth
# (scope "dbhub" en MCP_AUTH_TOKENS) es la única protección delante de él,
# por eso nunca se publica su puerto al host. Usa un usuario de BD de solo
# lectura salvo que realmente necesites que el MCP escriba.
# Si DBHUB_DSN no está definido, este MCP queda deshabilitado.
DBHUB_DSN=postgres://user:password@host.docker.internal:5432/dbname?sslmode=disable

# Solo necesario si el sidecar no se llama "dbhub-mcp" en la red de docker-compose
# o si corres DBHub fuera de Docker.
# DBHUB_MCP_TARGET=http://dbhub-mcp:8080/mcp
